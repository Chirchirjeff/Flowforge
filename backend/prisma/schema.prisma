// ──────────────────────────────────────────────────────────────────────────────
// FlowForge — Prisma Schema
// Run:  npx prisma migrate dev --name init
// ──────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Users ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userRoles             UserRole[]
  tasks                 Task[]
  createdCases          Case[]            @relation("CaseCreator")
  workflowDefinitions   WorkflowDefinition[] @relation("DefinitionCreator")
  auditEvents           AuditEvent[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique   // e.g. "workflow.create", "case.read"
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Workflow Definitions & Versions ─────────────────────────────────────────

model WorkflowDefinition {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User               @relation("DefinitionCreator", fields: [createdById], references: [id])
  versions  WorkflowVersion[]

  @@map("workflow_definitions")
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model WorkflowVersion {
  id           String        @id @default(uuid())
  definitionId String
  version      Int
  status       VersionStatus @default(DRAFT)
  graph        Json          // { nodes: [...], edges: [...] }
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  instances  WorkflowInstance[]

  @@unique([definitionId, version])
  @@map("workflow_versions")
}

// ─── Workflow Instances & Execution ──────────────────────────────────────────

enum InstanceStatus {
  CREATED
  RUNNING
  WAITING
  SUSPENDED
  COMPLETED
  CANCELLED
  FAILED
}

model WorkflowInstance {
  id         String         @id @default(uuid())
  versionId  String
  caseId     String?        @unique
  status     InstanceStatus @default(CREATED)
  currentNodeId String?
  variables  Json           @default("{}")
  startedAt  DateTime       @default(now())
  finishedAt DateTime?

  version WorkflowVersion @relation(fields: [versionId], references: [id])
  case    Case?           @relation(fields: [caseId], references: [id])
  events  WorkflowEvent[]
  tasks   Task[]

  @@map("workflow_instances")
}

model WorkflowEvent {
  id          String   @id @default(uuid())
  instanceId  String
  nodeId      String?
  eventType   String   // e.g. "instance.started", "task.completed", "transition.taken"
  actorId     String?
  data        Json     @default("{}")
  occurredAt  DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@map("workflow_events")
}

// ─── Cases ───────────────────────────────────────────────────────────────────

enum CaseStatus {
  OPEN
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
  CANCELLED
}

model Case {
  id                String     @id @default(uuid())
  caseNumber        String     @unique  // e.g. FF-2026-000123
  title             String
  description       String?
  status            CaseStatus @default(OPEN)
  createdById       String
  workflowVersionId String?
  metadata          Json       @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  closedAt          DateTime?

  createdBy        User              @relation("CaseCreator", fields: [createdById], references: [id])
  workflowInstance WorkflowInstance?
  tasks            Task[]
  auditEvents      AuditEvent[]

  @@map("cases")
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum TaskAction {
  APPROVE
  REJECT
  SUBMIT
  REQUEST_CHANGES
  REASSIGN
}

model Task {
  id           String     @id @default(uuid())
  instanceId   String
  caseId       String
  nodeId       String
  title        String
  description  String?
  status       TaskStatus @default(PENDING)
  assignedToId String?
  assignedRole String?
  formData     Json       @default("{}")
  dueAt        DateTime?
  priority     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  completedAt  DateTime?

  instance   WorkflowInstance @relation(fields: [instanceId], references: [id])
  case       Case             @relation(fields: [caseId], references: [id])
  assignedTo User?            @relation(fields: [assignedToId], references: [id])

  @@index([assignedToId])
  @@index([caseId])
  @@map("tasks")
}

// ─── Forms ───────────────────────────────────────────────────────────────────

model FormDefinition {
  id          String   @id @default(uuid())
  name        String
  description String?
  schema      Json     // array of field definitions
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("form_definitions")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditEvent {
  id            String   @id @default(uuid())
  actorId       String?
  action        String   // e.g. "user.login", "case.created", "task.completed"
  entityType    String?  // e.g. "Case", "Task", "WorkflowInstance"
  entityId      String?
  caseId        String?
  correlationId String?
  metadata      Json     @default("{}")
  occurredAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
  case  Case? @relation(fields: [caseId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([caseId])
  @@map("audit_events")
}
