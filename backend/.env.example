# ── FlowForge Backend — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Server
PORT=4000

# PostgreSQL — replace with your local credentials
DATABASE_URL="postgresql://flowforge_user:YOUR_PASSWORD@localhost:5432/flowforge?schema=public"

# JWT — generate a strong secret: openssl rand -base64 64
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"
